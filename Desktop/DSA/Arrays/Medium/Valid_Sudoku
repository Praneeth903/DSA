class Solution {
    public boolean isValidSudoku(char[][] board) {
        HashSet<String> hs = new HashSet<>();// Store the values as 'num row/col/box rownum/colnum/boxnum and not allow duplicates

        for(int i=0;i<9;i++){
            for(int j=0;j<9;j++){
                char num = board[i][j];
                if(num!='.'){
                if(!hs.add(num + " row " + i)||(!hs.add(num + " col " + j))||(!hs.add(num + " box " + i/3+","+j/3)))//here we are doing 2 operations in a single line !hs.add() this operation will add if the element is not present in the set and if not it will return false because the element should not be present in the same row, same column or same Box for box what we did is we shortened the indexes as 0-2 as 0, 3-5 as 1 and 6-8 as 2 by doing i/3 and j/3 which basically returns quotient. 
                return false;
            }
        }
        }
        return true;
    }
}