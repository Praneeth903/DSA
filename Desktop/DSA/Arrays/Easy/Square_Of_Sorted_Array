class Solution {
    public int[] sortedSquares(int[] nums) {
        int l = 0;
        int r = nums.length-1;
        int i = nums.length-1;
        int [] res = new int[nums.length];
        while(i>=0){
            if(nums[l]*nums[l] >= nums[r]*nums[r] ){
                res[i] = nums[l] * nums[l];
                i--;
                l++;
            }
            else{
                res[i] = nums[r] * nums[r];
                i--;
                r--;
            }
        }
        return res;
    }
}